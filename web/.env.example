# Where the Rails API lives. Telegram needs HTTPS, so in development point this
# at the same tunnel that serves the Mini App, or at a second one for Rails.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# The self-hosted Addis map style (PMTiles on R2). Leave unset and the Map
# tile says the map isn't available; the list still works.
# VITE_MAP_STYLE_URL=https://tiles.example.com/addis/style.json

# Where a shared stamp links to: the bot's Mini App link once it exists.
# VITE_SHARE_URL=https://t.me/<bot>/<app>
