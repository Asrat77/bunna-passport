# Where the Rails API lives. Leave unset to call /api/v1 on the same origin:
# `npm run dev` proxies it to Rails (API_ORIGIN, default http://localhost:3000),
# so one HTTPS tunnel serves Telegram both. A different origin needs CORS.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# The self-hosted Addis map styles (PMTiles on R2), as printed by
# script/publish_addis_map. Leave unset and the Map tile says the map isn't
# available; the list still works. Dark falls back to the light style.
# VITE_MAP_STYLE_URL=https://pub-<id>.r2.dev/style-light.json
# VITE_MAP_STYLE_DARK_URL=https://pub-<id>.r2.dev/style-dark.json

# Where a shared stamp links to: the bot's Mini App link once it exists.
# VITE_SHARE_URL=https://t.me/<bot>/<app>
