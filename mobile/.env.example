# Copy to .env and fill in. .env is gitignored; this example is not, so never
# put real values here.

# Public Mapbox token used by the map at runtime.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Secret Mapbox token used only to download the native SDK at build time.
# EAS supplies this as a secret; it must never reach source control.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Where the Rails API lives. Leave unset in development: the client derives the
# host from the Metro server it was loaded from, which is reachable from a
# simulator, an emulator, and a physical phone alike.
#
# Set it to reach a real backend. It must include the /api/v1 path and carry no
# trailing slash, because request paths are appended directly.
#
# Production: https://bunna-passport.southafricanorth.cloudapp.azure.com/api/v1
EXPO_PUBLIC_API_BASE_URL=
