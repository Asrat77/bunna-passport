<p class="eyebrow">@<%= @user.handle %></p>
<h1><%= @user.display_name %></h1>
<section class="metric-grid">
  <article class="metric"><strong><%= @user.verified_check_ins_count %></strong><span>Verified cups</span></article>
  <article class="metric"><strong><%= @user.stamps_count %></strong><span>Shops stamped</span></article>
  <article class="metric"><strong><%= @user.contributions.accepted.count %></strong><span>Accepted contributions</span></article>
</section>
<section class="panel">
  <%= form_with model: [ :console, @user ], class: "stack", data: { turbo: false } do |form| %>
    <%= form.label :trust_level %>
    <%= form.select :trust_level, User.trust_levels.keys.map { |level| [ level.humanize, level ] } %>
    <%= form.submit "Update trust" %>
  <% end %>
</section>
