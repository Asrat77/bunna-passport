<div class="page-heading">
  <div><p class="eyebrow">Moderation</p><h1>Contributions</h1></div>
  <div class="actions">
    <%= link_to "All", console_contributions_path %>
    <%= link_to "Pending", console_contributions_path(status: "pending") %>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Type</th><th>Contributor</th><th>Status</th><th>Confirmations</th><th>Submitted</th></tr></thead>
    <tbody>
      <% @contributions.each do |contribution| %>
        <tr>
          <td><%= link_to contribution.contributable_type.demodulize, console_contribution_path(contribution) %></td>
          <td>@<%= contribution.user.handle %></td>
          <td><span class="status status--<%= contribution.status %>"><%= contribution.status.humanize %></span></td>
          <td><%= contribution.confirmations.size %></td>
          <td><%= time_ago_in_words(contribution.created_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
