<% content_for :title, "Contributions · Bunna Passport" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">Moderation</p>
    <h1>Contributions</h1>
    <p class="muted">New cafés, edits and photos people sent in. Whoever sent one hears the outcome in Telegram.</p>
  </div>
</div>

<nav class="tabs" aria-label="Filter contributions">
  <% Console::ContributionsController::FILTERS.each do |filter| %>
    <% count = filter == "all" ? @counts.values.sum : (filter == "approved" ? @counts["approved"].to_i + @counts["auto_approved"].to_i : @counts[filter].to_i) %>
    <%= link_to console_contributions_path(status: filter), class: ["tab", ("tab--current" if @filter == filter)], aria: { current: (@filter == filter ? "page" : nil) } do %>
      <%= filter.humanize %> <span class="tab__count"><%= count %></span>
    <% end %>
  <% end %>
</nav>

<% if @contributions.empty? %>
  <section class="panel empty-state">
    <p><strong><%= @filter == "pending" ? "Nothing waiting." : "Nothing here yet." %></strong></p>
    <% if @filter == "pending" %><p class="muted">Every contribution has been looked at.</p><% end %>
  </section>
<% else %>
  <div class="table-wrap">
    <table class="queue-table">
      <thead><tr><th>What</th><th>Details</th><th>From</th><th>Status</th><th>Sent</th></tr></thead>
      <tbody>
        <% @contributions.each do |contribution| %>
          <tr>
            <td>
              <span class="kind kind--<%= contribution.contributable_type.demodulize.underscore %>"><%= contribution_kind(contribution) %></span>
              <%= link_to contribution.shop_name, console_contribution_path(contribution), class: "queue-table__title" %>
            </td>
            <td class="muted"><%= contribution_summary(contribution).to_s.truncate(90) %></td>
            <td>
              @<%= contribution.user.handle %>
              <small class="muted"><%= contribution.user.trust_level.humanize %></small>
            </td>
            <td>
              <span class="status status--<%= contribution.status %>"><%= contribution.status.humanize %></span>
              <% if contribution.pending? && contribution.confirmations.size.positive? %>
                <small class="muted"><%= pluralize(contribution.confirmations.size, "confirmation") %></small>
              <% end %>
            </td>
            <td><%= time_ago_in_words(contribution.created_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
