<% if shop.errors.any? %>
  <div class="errors"><%= shop.errors.full_messages.to_sentence %></div>
<% end %>
<%= form_with model: [ :console, shop ], class: "stack" do |form| %>
  <div class="form-grid">
    <div><%= form.label :name, "Latin name" %><%= form.text_field :name, required: true %></div>
    <div><%= form.label :name_am, "Amharic name" %><%= form.text_field :name_am, required: true %></div>
    <div><%= form.label :neighborhood_id %><%= form.collection_select :neighborhood_id, Neighborhood.alphabetically, :id, :name %></div>
    <div><%= form.label :landmark %><%= form.text_field :landmark, required: true %></div>
    <div><%= form.label :latitude %><%= form.number_field :latitude, step: :any, required: true %></div>
    <div><%= form.label :longitude %><%= form.number_field :longitude, step: :any, required: true %></div>
    <div><%= form.label :status %><%= form.select :status, Shop.statuses.keys.map { |value| [ value.humanize, value ] } %></div>
    <div><%= form.label :price_band %><%= form.select :price_band, Shop.price_bands.keys.map { |value| [ value.humanize, value ] }, include_blank: true %></div>
  </div>
  <fieldset>
    <legend>Amenities</legend>
    <div class="checkboxes">
      <% Shop::AMENITIES.each do |amenity| %>
        <%= label_tag "shop_amenities_#{amenity}" do %>
          <%= hidden_field_tag "shop[amenities][#{amenity}]", "0" %>
          <%= check_box_tag "shop[amenities][#{amenity}]", "1", shop.amenities[amenity], id: "shop_amenities_#{amenity}" %>
          <%= amenity.humanize %>
        <% end %>
      <% end %>
    </div>
  </fieldset>
  <%= label_tag "shop_hours_json", "Weekly hours JSON" %>
  <%= text_area_tag "shop[hours_json]", (shop.hours&.schedule&.to_json || ""), id: "shop_hours_json", placeholder: '{"monday":[{"opens":"07:00","closes":"18:00"}]}' %>
  <%= form.submit %>
<% end %>
