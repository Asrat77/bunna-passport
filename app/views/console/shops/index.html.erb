<div class="page-heading">
  <div><p class="eyebrow">Catalog</p><h1>Coffee shops</h1></div>
  <div class="actions">
    <%= link_to "Bulk add", new_console_shop_batch_path, class: "button button--secondary" %>
    <%= link_to "New shop", new_console_shop_path, class: "button" %>
  </div>
</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Shop</th><th>Neighborhood</th><th>Status</th><th>Hours</th><th>Activity</th></tr></thead>
    <tbody>
      <% @shops.each do |shop| %>
        <tr>
          <td><%= link_to shop.name, console_shop_path(shop) %><br><small><%= shop.name_am %></small></td>
          <td><%= shop.neighborhood.name %></td>
          <td><span class="status status--<%= shop.status %>"><%= shop.status.humanize %></span></td>
          <td><%= shop.hours&.freshness || "unknown" %></td>
          <td><%= shop.check_ins_count %> cups · <%= shop.stamps_count %> stamps</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
